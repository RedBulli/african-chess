# Public repository allowlist. Everything else stays local, including research,
# training, cloud tools, run data, handoffs, generated files and credentials.
# Add new public files explicitly here before staging them.
/*
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/README.md
!/LICENSE

!/src/
/src/*
!/src/lib.rs
!/src/browser.rs
!/src/game.rs
!/src/learning.rs
!/src/movegen.rs
!/src/opponent.rs
!/src/play.rs
!/src/position.rs
!/src/types.rs

!/tests/
/tests/*
!/tests/browser.rs
!/tests/learning.rs
!/tests/play.rs
!/tests/rules.rs

!/web/
/web/*
!/web/README.md
!/web/app.js
!/web/build.py
!/web/server.py
!/web/style.css
!/web/icon.svg
!/web/index.html
!/web/engine-client.js
!/web/engine-worker.js
!/web/engine-client.test.mjs
!/web/browser-test.mjs
!/web/wasm-test.mjs
!/web/test_server.py

!/models/
/models/*
!/models/browser.weights

!/src/bin/
/src/bin/*
!/src/bin/web-engine.rs

!/Dockerfile
!/.dockerignore
!/Caddyfile

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/publish.yml
